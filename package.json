    "express": "^4.21.2",
    "lucide-svelte": "^0.475.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.20.2",
    "three": "^0.182.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
